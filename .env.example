MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_CHAT_MODEL=mistral-small-latest

# Auth — set this to protect /api/ingest and /api/query
# Leave unset to disable auth (dev mode)
RAG_API_KEY=your_secret_api_key_here

# CORS — comma-separated list of allowed origins, or "*" for dev
ALLOWED_ORIGINS=*

# Retrieval settings
TOP_K=5
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Hallucination filter
HALLUCINATION_REJECTION_THRESHOLD=0.4

# Storage
VECTOR_STORE_PATH=data/vector_store.pkl
